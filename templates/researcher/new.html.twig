{% extends 'base.html.twig' %}

{% block title %}Añadir investigador · SIAB{% endblock %}

{% block body %}
<main class="container-xl py-4">
    <div class="row justify-content-center">
        <div class="col-12 col-lg-9 col-xl-7">
            <div class="mb-4">
                <div class="eyebrow">
                    <a href="{{ path('app_researcher_index') }}">Padrón</a> · Añadir
                </div>
                <h1 class="siab-brand fs-3 mb-0">Añadir investigador</h1>
            </div>

            {{ include('_flashes.html.twig') }}

            {% if not engine_healthy %}
                <div class="alert alert-danger d-flex flex-wrap align-items-center justify-content-between gap-2" role="alert">
                    <div>
                        <b>El motor de análisis no responde.</b>
                        Hace falta para buscar a la persona en OpenAlex.
                    </div>
                    {{ include('_engine_start.html.twig', {volver: 'app_researcher_index', clase: 'btn btn-sm btn-danger'}) }}
                </div>
            {% endif %}

            <div class="card shadow-sm">
                <div class="card-header"><h2 class="h6 mb-0">Buscar en OpenAlex</h2></div>
                <div class="card-body">
                    <p class="small text-body-secondary">
                        La ficha se crea con lo que devuelve OpenAlex, no con lo que se escriba aquí:
                        así el ORCID y el ID quedan verificados desde el principio, que es lo que evita
                        que un análisis posterior atribuya los trabajos de otra persona.
                    </p>

                    <form method="post" action="{{ path('app_researcher_new') }}">
                        <input type="hidden" name="_csrf_token" data-controller="csrf-protection" value="{{ csrf_token('submit') }}">

                        <label for="query" class="form-label">Investigador</label>
                        <input type="text" class="form-control form-control-lg" id="query" name="query"
                               value="{{ query }}" required autofocus autocomplete="off" spellcheck="false"
                               placeholder="0000-0002-1692-2216">
                        <div class="form-text mb-3">
                            ORCID (0000-0002-1692-2216), ID de OpenAlex (A5065080063) o nombre completo.
                        </div>

                        <div class="d-flex gap-2">
                            <button class="btn btn-primary" type="submit">Buscar</button>
                            <a class="btn btn-outline-secondary" href="{{ path('app_researcher_index') }}">Cancelar</a>
                        </div>
                    </form>
                </div>
                <div class="card-footer small text-body-secondary">
                    Añadirlo no lanza ningún análisis: queda en el padrón y puedes analizarlo cuando quieras.
                </div>
            </div>

            {% if candidates is not empty %}
                {{ include('analysis/_candidates.html.twig', {
                    action: 'app_researcher_new',
                    label: 'Añadir al padrón',
                    pass_report: false,
                }) }}
            {% endif %}
        </div>
    </div>
</main>
{% endblock %}
