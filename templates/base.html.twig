<!DOCTYPE html>
<html lang="es" data-bs-theme="light">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1">
        <title>{% block title %}SIAB · Análisis de Citas{% endblock %}</title>
        {# The A/B/self meter, the one mark every screen already shows. A file rather
           than the skeleton's inline emoji: it is a real asset now, so it gets
           fingerprinted and cached like the rest. #}
        <link rel="icon" href="{{ asset('images/favicon.svg') }}" type="image/svg+xml">

        {% block head_extra %}{% endblock %}

        {% block stylesheets %}{% endblock %}

        {% block javascripts %}
            {% block importmap %}{{ importmap('app') }}{% endblock %}
        {% endblock %}

        {% set frankenphp_hot_reload = app.request.server.get('FRANKENPHP_HOT_RELOAD') %}
        {% if frankenphp_hot_reload %}
        <meta name="frankenphp-hot-reload:url" content="{{ frankenphp_hot_reload }}">
        <script src="https://cdn.jsdelivr.net/npm/idiomorph"></script>
        <script src="https://cdn.jsdelivr.net/npm/frankenphp-hot-reload/+esm" type="module"></script>
        {% endif %}
    </head>
    <body class="bg-body-tertiary">
        {% block navbar %}
            <nav class="navbar navbar-expand-lg bg-body border-bottom sticky-top">
                <div class="container-xl">
                    <a class="navbar-brand siab-brand d-flex align-items-baseline gap-2" href="{{ path('app_dashboard') }}">
                        <span><span class="text-primary fw-semibold">SIAB</span> · Análisis de Citas</span>
                        <small class="d-none d-lg-inline text-body-secondary fs-6 border-start ps-2">Centro de Ciencias Matemáticas · UNAM</small>
                    </a>

                    <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#siab-nav" aria-controls="siab-nav" aria-expanded="false" aria-label="Menú">
                        <span class="navbar-toggler-icon"></span>
                    </button>

                    <div class="collapse navbar-collapse" id="siab-nav">
                        <div class="ms-auto d-flex align-items-center gap-2 flex-wrap py-2 py-lg-0">
                            {% set route = app.request.attributes.get('_route') %}
                            <ul class="navbar-nav flex-row gap-3 me-lg-2">
                                <li class="nav-item">
                                    <a class="nav-link py-0 {{ route == 'app_researcher_index' ? 'active fw-semibold' }}"
                                       href="{{ path('app_researcher_index') }}">Investigadores</a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link py-0 {{ route == 'app_run_index' ? 'active fw-semibold' }}"
                                       href="{{ path('app_run_index') }}">Análisis</a>
                                </li>
                                {% if is_granted('ROLE_ADMIN') %}
                                    <li class="nav-item dropdown">
                                        <a class="nav-link py-0 dropdown-toggle {{ route starts with 'app_admin_' ? 'active fw-semibold' }}"
                                           href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">Administración</a>
                                        <ul class="dropdown-menu">
                                            <li><a class="dropdown-item" href="{{ path('app_admin_settings') }}">Configuración del motor</a></li>
                                            <li><a class="dropdown-item" href="{{ path('app_admin_users') }}">Cuentas</a></li>
                                            <li><a class="dropdown-item" href="{{ path('app_admin_audit') }}">Registro de actividad</a></li>
                                        </ul>
                                    </li>
                                {% endif %}
                            </ul>

                            {% block navbar_extra %}{% endblock %}

                            {% if app.user %}
                                <div class="dropdown">
                                    <button class="btn btn-sm btn-outline-secondary dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                                        {{ app.user.displayName ?? app.user.email }}
                                    </button>
                                    <ul class="dropdown-menu dropdown-menu-end">
                                        <li><span class="dropdown-item-text small text-body-secondary">{{ app.user.email }}</span></li>
                                        {% if is_granted('ROLE_ADMIN') %}
                                            <li><span class="dropdown-item-text small text-body-secondary">Administrador</span></li>
                                        {% endif %}
                                        <li><hr class="dropdown-divider"></li>
                                        <li>
                                            <form method="post" action="{{ path('app_logout') }}" class="px-1">
                                                <input type="hidden" name="_csrf_token" data-controller="csrf-protection" value="{{ csrf_token('logout') }}">
                                                <button class="dropdown-item" type="submit">Cerrar sesión</button>
                                            </form>
                                        </li>
                                    </ul>
                                </div>
                            {% endif %}

                            <button class="btn btn-sm btn-outline-secondary" type="button" data-theme-toggle title="Cambiar tema">☾</button>
                        </div>
                    </div>
                </div>
            </nav>
        {% endblock %}

        {% block body %}{% endblock %}
    </body>
</html>
