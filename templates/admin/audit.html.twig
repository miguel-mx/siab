{% extends 'base.html.twig' %}

{% block title %}Registro de actividad · SIAB{% endblock %}

{% block body %}
<main class="container-xl py-4">
    {{ include('_flashes.html.twig') }}

    <div class="d-flex flex-wrap align-items-end justify-content-between gap-3 mb-4">
        <div>
            <div class="eyebrow">
                <a href="{{ path('app_dashboard') }}">Panel</a> · Administración
            </div>
            <h1 class="siab-brand fs-3 mb-0">Registro <span class="text-body-secondary fs-5">· {{ total }}</span></h1>
        </div>
        <div class="d-flex gap-2">
            <a class="btn btn-outline-secondary" href="{{ path('app_admin_users') }}">Cuentas →</a>
            <a class="btn btn-outline-secondary" href="{{ path('app_admin_settings') }}">Configuración →</a>
        </div>
    </div>

    <div class="alert alert-secondary py-2 px-3 small" role="alert">
        Qué se cambió, quién lo hizo y cuándo. Sólo se añade: nada de aquí se edita ni se
        borra desde SIAB, y los análisis eliminados siguen apareciendo con el nombre que
        tenían — es lo único que queda de ellos.
    </div>

    <div class="card shadow-sm">
        <div class="card-header d-flex flex-wrap gap-2">
            {% set tabs = {'': 'Todo', 'run': 'Análisis', 'user': 'Cuentas'} %}
            {% for value, label in tabs %}
                <a class="btn btn-sm {{ (type ?? '') == value ? 'btn-secondary' : 'btn-outline-secondary' }}"
                   href="{{ path('app_admin_audit', value ? {tipo: value} : {}) }}">{{ label }}</a>
            {% endfor %}
        </div>

        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead>
                    <tr class="colhead">
                        <th scope="col">Cuándo</th>
                        <th scope="col">Qué</th>
                        <th scope="col">Sobre</th>
                        <th scope="col">Quién</th>
                    </tr>
                </thead>
                <tbody>
                {% for entry in entries %}
                    <tr>
                        <td class="text-nowrap">
                            <div class="stamp">{{ entry.occurredAt|fecha('d MMM y, HH:mm') }}</div>
                            <div class="stamp-rel">{{ entry.occurredAt|hace }}</div>
                        </td>
                        <td>
                            <span class="badge rounded-pill border fw-medium
                                         {{ entry.action.isSevere
                                            ? 'text-danger-emphasis bg-danger-subtle border-danger-subtle'
                                            : 'text-body-secondary bg-body-tertiary' }}">
                                {{ entry.action.label }}
                            </span>
                            {% if entry.details %}
                                <div class="small text-body-secondary mt-1">
                                    {% for key, value in entry.details %}
                                        {%- if value is not null -%}
                                            <span class="me-2">{{ key }}: <span class="font-monospace">{{ value is same as(true) ? 'sí' : (value is same as(false) ? 'no' : value) }}</span></span>
                                        {%- endif -%}
                                    {% endfor %}
                                </div>
                            {% endif %}
                        </td>
                        {# Subject is what the entry is about, actor is provenance —
                           at the same weight they read as one undifferentiated pair. #}
                        <td class="stamp">{{ entry.subjectLabel }}</td>
                        <td class="small text-body-secondary">
                            {% if entry.actorLabel == 'sistema' %}
                                <span class="text-body-secondary fst-italic">sistema</span>
                            {% else %}
                                {{ entry.actorLabel }}
                            {% endif %}
                        </td>
                    </tr>
                {% else %}
                    <tr>
                        <td colspan="4" class="text-center text-body-secondary py-5">
                            Todavía no hay nada registrado.
                        </td>
                    </tr>
                {% endfor %}
                </tbody>
            </table>
        </div>

        {% if pages > 1 %}
            <div class="card-footer d-flex justify-content-between align-items-center">
                {% set filters = {tipo: type} %}
                <span class="small text-body-secondary">Página {{ page }} de {{ pages }}</span>
                <div class="btn-group btn-group-sm">
                    <a class="btn btn-outline-secondary {{ page <= 1 ? 'disabled' }}"
                       href="{{ path('app_admin_audit', filters|merge({p: page - 1})) }}">‹</a>
                    <a class="btn btn-outline-secondary {{ page >= pages ? 'disabled' }}"
                       href="{{ path('app_admin_audit', filters|merge({p: page + 1})) }}">›</a>
                </div>
            </div>
        {% endif %}
    </div>
</main>
{% endblock %}
