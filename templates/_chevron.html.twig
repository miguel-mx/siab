{# Fold indicator for a <details>. Rotates a quarter turn when its section opens —
   see .expander and .foldhead in app.css, which own that rotation. #}
<svg class="chev" width="{{ size|default(10) }}" height="{{ size|default(10) }}"
     viewBox="0 0 16 16" fill="currentColor" aria-hidden="true">
    <path d="M5.5 2.5 11 8l-5.5 5.5-1-1L9 8 4.5 3.5z"/>
</svg>
