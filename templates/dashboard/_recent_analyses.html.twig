{# Recent runs with the A/B/self proportion meter. #}
<section class="card shadow-sm h-100">
    <div class="card-header d-flex align-items-center justify-content-between">
        <h2 class="h6 mb-0">Análisis recientes</h2>
        <a class="small text-decoration-none" href="{{ path('app_run_index') }}">Ver historial completo →</a>
    </div>

    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead>
                <tr class="colhead">
                    <th scope="col">Investigador</th>
                    <th scope="col">Fecha</th>
                    <th scope="col">Estado</th>
                    <th scope="col" style="min-width: 11rem;">Tipo A / B / autocitas</th>
                    <th scope="col"></th>
                </tr>
            </thead>
            <tbody>
            {% for run in recent %}
                {{ include('analysis/_run_row.html.twig', {run: run}) }}
            {% else %}
                <tr>
                    <td colspan="5" class="text-center text-body-secondary py-5">
                        Todavía no hay análisis.
                        <a href="{{ path('app_analysis_new') }}">Lanza el primero</a>.
                    </td>
                </tr>
            {% endfor %}
            </tbody>
        </table>
    </div>

    {% if recent is not empty %}
        <div class="card-footer">{{ include('_legend.html.twig') }}</div>
    {% endif %}
</section>
